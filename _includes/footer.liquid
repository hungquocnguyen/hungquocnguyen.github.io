{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}.
  Last updated: {{ 'now' | date: '%-d %B, %Y' }}.
{% endcapture %}

<footer class="sticky-bottom mt-5" role="contentinfo">
  <div class="container">
    {{ footer_contents }}
  </div>
</footer>
